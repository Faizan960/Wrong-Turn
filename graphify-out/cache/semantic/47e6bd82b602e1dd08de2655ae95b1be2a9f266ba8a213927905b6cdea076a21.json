{"nodes": [{"id": "setup_event_bus", "label": "Event Bus (GameEvents)", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decouples everything: InputManager -> GameEvents <- GameManager <- UI/Audio/Difficulty. No manager references another except through SaveManager.Data and DifficultyManager read-only values."}, {"id": "setup_bootstrapper_autocreation", "label": "Bootstrapper Auto-Creation", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managers are auto-created by Bootstrapper so no scene objects are needed; Bootstrapper detects manually placed managers and skips creation."}, {"id": "setup_main_scene", "label": "Main Scene", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single scene design: Bootstrap GO, Main Camera, Canvas with MenuScreen, GameplayHUD, GameOverScreen, PauseOverlay."}, {"id": "setup_phase2_color_rules", "label": "Phase 2 Color Rules", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White=Opposite, Blue=Same, Red=Ignore, Green=DoubleOpposite; unlocked by score thresholds 0/20/50/100/150. DifficultyManager.RollColorRule assigns, RuleEngine validates, UI only renders."}, {"id": "setup_chaos_system_flow", "label": "Chaos System Flow", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DifficultyManager.ChaosChance (5% at 150 -> 50% at 300) -> ChaosManager rolls between instructions -> OnChaosStarted/OnChaosEnded -> GameManager applies gameplay warps, FeedbackManager renders visuals. ChaosManager never touches FeedbackManager. 10 chaos types including ScreenRotate, ReverseControls, FakeGameOver, FakeInstructions."}, {"id": "setup_daily_challenge", "label": "Daily Challenge", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic from yyyymmdd seed so everyone gets the same challenge. Five archetypes: Only-rule, No Mistakes, Double Speed, One Life, Gauntlet. Constraints apply through existing authorities reacting to OnChallengeStarted; one reward per day via lastDailyCompletedSeed."}, {"id": "setup_achievements", "label": "Achievements", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "14 built-in definitions in AchievementData.All; unlocks persist in PlayerData.unlockedAchievements; OnAchievementUnlocked(id, coinBonus) pays via CurrencyManager and AchievementUI toasts."}, {"id": "setup_currency", "label": "Currency (Coins)", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coins = run score + maxCombo/5 plus achievement bonuses and daily challenge rewards; OnCoinsChanged(total, delta) drives UI."}, {"id": "setup_cosmetics", "label": "Cosmetics", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog asset in Resources; renderers read CosmeticManager.EquippedFor(category) and listen to OnCosmeticEquipped. Visual only \u2014 no gameplay reads cosmetics."}, {"id": "setup_rewarded_ads", "label": "Rewarded Ads", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IAdProvider -> MockAdProvider (dev) -> real AdMob/Unity Ads adapter later; only AdsManager.OnSingletonAwake changes. Rewards: ContinueRun, DoubleCoins, DailyBonus via OnAdRewardEarned. No interstitials or banners."}, {"id": "setup_leaderboards", "label": "Leaderboards", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ILeaderboardProvider -> MockLeaderboardProvider; swap in Play Games Services at release. Submits high score and longest combo on OnRunEnded; daily challenge board on completed challenges."}, {"id": "setup_object_pooling", "label": "Object Pooling", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ObjectPoolManager Get/Release/Prewarm keyed by prefab; route all effect spawns through it \u2014 never Instantiate/Destroy in gameplay. Part of no-per-frame-allocation policy."}, {"id": "setup_performance_monitoring", "label": "Performance Monitoring", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FPS/frame time/memory/GC overlay, editor and development builds only (#if UNITY_EDITOR || DEVELOPMENT_BUILD), toggled with F3; stripped from release."}, {"id": "setup_save_persistence", "label": "SaveManager Persistence", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SaveManager remains the sole persistence layer; all managers persist through it (settings via SaveManager.Data, lifetime stats, unlocked achievements)."}, {"id": "setup_release_checklist", "label": "Release Build Checklist", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IL2CPP + ARM64, R8 minify, portrait lock, sprite atlas, Vorbis music/PCM SFX; targets 60 FPS, <150 MB RAM, <100 MB APK."}, {"id": "setup_feedbackmanager_scene_placed", "label": "Scene-Placed FeedbackManager", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FeedbackManager is scene-placed because it needs scene refs (camera rig, particles, HUD elements) and subscribes to GameEvents only; chaos logic must not grow into it."}, {"id": "setup_input_schemes", "label": "Input Schemes (Swipe + Tap)", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swipe or tap depending on scheme toggled on the menu; editor supports arrow keys/WASD, mouse-drag swipe, click zones in Tap mode."}, {"id": "setup_dotween", "label": "DOTween", "file_type": "concept", "source_file": "SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required from Checkpoint 2 for tweened feedback and chaos effects like ScreenRotate."}], "edges": [{"source": "core_gameevents_gameevents", "target": "setup_event_bus", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "managers_inputmanager_inputmanager", "target": "core_gameevents_gameevents", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weight": 1.0}, {"source": "managers_gamemanager_gamemanager", "target": "core_gameevents_gameevents", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SETUP.md", "source_location": null, "weigh